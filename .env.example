# Copy to .env for the normal server. Do not commit .env.
PORT=3000
LISTEN_HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:3000
APP_LABEL="RAG · Учебный тренажёр"
MONGO_URL=mongodb://127.0.0.1:27017/moodle_lti_rag_lab
DATA_DIR=./data/attempts

# Leave all six fields blank until registering the tool in Moodle.
# Later PUBLIC_URL must be the public HTTPS origin (no subpath).
MOODLE_ISSUER=
MOODLE_CLIENT_ID=
MOODLE_DEPLOYMENT_ID=
MOODLE_AUTH_URL=
MOODLE_TOKEN_URL=
MOODLE_JWKS_URL=
