{
  "name": "moodle-lti-rag-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Три задания по RAG-рекомендательной системе интернет-магазина для лабораторной Moodle LTI 1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' test/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "demo": "node scripts/local-demo.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "ltijs": "7.0.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
